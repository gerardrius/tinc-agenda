# Google Calendar (optional — OAuth Client ID, see README for setup)
VITE_GOOGLE_CLIENT_ID=

# Supabase (optional — enables cross-device sync + magic-link login).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# REQUIRED — shared secret every api/*.js route checks (api/_auth.js)
# before touching real data. Baked into the client bundle, so it stops a
# public URL being wide open but is not a substitute for real per-user
# login (see api/_auth.js's comment for the upgrade path via Supabase).
# Generate with: openssl rand -hex 32
# Every api/*.js route returns 500 until this is set.
VITE_API_ACCESS_TOKEN=

# Google Maps JS API (Vida → Son sleep map). Key is restricted to HTTP
# referrers (this Vercel domain + localhost) in Cloud Console, project
# garmin-sync (project-d225e115-18b7-433d-ae0) — safe to expose client-side.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=

# Server-only (api/sleep.js) — bearer token for the read-only sleep-map-data
# Cloud Function. Do NOT prefix with VITE_: must never reach the client.
SLEEP_MAP_READ_TOKEN=

# Server-only (api/finances.js, api/garmin.js) — full JSON key of the
# read-only tinc-agenda-reader service account (bigquery.dataViewer +
# bigquery.jobUser on the imagin-finance-sync and garmin BigQuery projects).
# Do NOT prefix with VITE_: must never reach the client.
BIGQUERY_SERVICE_ACCOUNT_KEY=

# Native Google auth (api/google-token.js) — client secret for the
# authorization-code + PKCE exchange/refresh. Do NOT prefix with VITE_.
GOOGLE_CLIENT_SECRET=

# Server-only (api/import-timeline.js) — bearer token for the import-timeline
# Cloud Function (writes life.sleep_locations from a Google Timeline export
# uploaded in Son → Mapa). Do NOT prefix with VITE_.
LIFE_TRACKING_TOKEN=

# Server-only (api/sync-referee-reports.js) — Drive folder id for the
# current season's RFEF report PDFs, shared read-only with
# tinc-agenda-reader@imagin-finance-sync.iam.gserviceaccount.com.
REFEREE_REPORTS_FOLDER_ID=

# Server-only (api/sync-garmin-now.js) — the garmin-sync Cloud Run service's
# own X-Automation-Token (same one its Cloud Scheduler jobs send; unrelated
# to Google Cloud IAM). Do NOT prefix with VITE_.
GARMIN_SYNC_TOKEN=
