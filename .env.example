# Google Calendar (optional — OAuth Client ID, see README for setup)
VITE_GOOGLE_CLIENT_ID=

# Supabase (optional — enables cross-device sync + magic-link login)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Maps JS API (Vida → Son sleep map). Key is restricted to HTTP
# referrers (this Vercel domain + localhost) in Cloud Console, project
# garmin-sync (project-d225e115-18b7-433d-ae0) — safe to expose client-side.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=

# Server-only (api/sleep.js) — bearer token for the read-only sleep-map-data
# Cloud Function. Do NOT prefix with VITE_: must never reach the client.
SLEEP_MAP_READ_TOKEN=
